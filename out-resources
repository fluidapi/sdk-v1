    "/oauth2/token": {
      "post": {
        "summary": "Issue M2M token (client_credentials)",
        "description": "OAuth2 token endpoint for M2M (machine-to-machine) access.\nOnly `grant_type=client_credentials` is supported.\n\nPerforms a `client_credentials` grant against the Authorization Server and\nreturns a Hydra-issued access token (JWT) following RFC 6749 token response format.\n\nThe OAuth2 client must be registered first via\n`POST /v1/tenants/{tenant_id}/credentials`.\n\nBy default the token is issued with all scopes configured for the tenant.\nYou can request a subset by passing `scope`. Requesting a scope not in the\ntenant's allowlist returns `400 invalid_scope`.\n\n> **User session refresh:** use `POST /users/token/refresh` instead.\n> The client secret is handled server-side and must not be sent by browsers.\n",
        "operationId": "issueM2MToken",
        "tags": ["tokens"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ClientCredentialsRequest"
              },
              "example": {
                "grant_type": "client_credentials",
                "client_id": "fld-cred-acme-corp--api--postman-primary",
                "client_secret": "dGhpcyBpcyBhIHNlY3JldA"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "M2M token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenData"
                },
                "example": {
                  "access_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "token_type": "bearer",
                  "expires_in": 3600,
                  "scope": "fluid:api"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuth2BadRequest"
          },
          "401": {
            "description": "Invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "invalid_client",
                  "error_description": "invalid client credentials"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/OAuth2BadGateway"
          }
        },
        "security": []
      }
    },
    "/oauth2/token-fluid-legacy": {
      "post": {
        "summary": "Issue Fluid-signed M2M token (legacy)",
        "description": "**Deprecated** — prefer `POST /oauth2/token` with `grant_type=client_credentials`.\n\nValidates client credentials against the Authorization Server and generates\na JWT signed by Fluid carrying `workspace_id`, `tenant_id`, `client_id`, and\n`credential_type` claims.\n",
        "operationId": "issueFluidTokenLegacy",
        "deprecated": true,
        "tags": ["tokens"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ClientCredentialsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fluid-signed M2M token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenData"
                },
                "example": {
                  "access_token": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ik9UO...",
                  "token_type": "bearer",
                  "expires_in": 3600,
                  "scope": "fluid:api"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuth2BadRequest"
          },
          "401": {
            "description": "Invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "invalid_client",
                  "error_description": "invalid client credentials"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/OAuth2BadGateway"
          }
        },
        "security": []
      }
    },
    "/users/token": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          },
          {
            "BasicAuth": []
          }
        ],
        "summary": "Issue bootstrap token for end user",
        "description": "Issues a short-lived bootstrap JWT for an end user (workspace or customer scope).\n\nThe token lifetime is capped at `BOOTSTRAP_TOKEN_TTL_SECONDS` (default: 300s)\nregardless of the `expires_in` value in the request. This token is single-use\nand is intended to be exchanged immediately via `POST /users/token/exchange`.\n\nSupported authentication modes:\n- `Authorization: Bearer <m2m_token>` — preferred. The token must be a\n  Fluid-signed M2M JWT with `scope` including `fluid:api`.\n  Canonical first-access provisioning is only available in this mode.\n- HTTP Basic Auth with `client_id` + `client_secret`.\n  Provisioning is skipped in this mode.\n\nIf `customer_external_id` is present, the JWT is issued with `scope: customer`.\nOtherwise it is issued with `scope: workspace`.\n",
        "operationId": "issueUserToken",
        "tags": ["tokens"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bootstrap token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserTokenData"
                },
                "example": {
                  "access_token": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ik9UO...",
                  "token_type": "bearer",
                  "expires_in": 300
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — malformed body, missing `external_id`, or missing `email` when first-access provisioning is needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "examples": {
                  "invalid_body": {
                    "value": {
                      "error": "invalid_request",
                      "error_description": "invalid JSON body: ..."
                    }
                  },
                  "external_id_required": {
                    "value": {
                      "error": "invalid_request",
                      "error_description": "external_id is required"
                    }
                  },
                  "email_required": {
                    "value": {
                      "error": "invalid_request",
                      "error_description": "email is required for first access provisioning"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid client credentials or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "invalid_client",
                  "error_description": "invalid client credentials"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, provisioning requires Bearer auth, or customer/user is revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "examples": {
                  "insufficient_scope": {
                    "value": {
                      "error": "insufficient_scope",
                      "error_description": "token missing required scope"
                    }
                  },
                  "customer_revoked": {
                    "value": {
                      "error": "customer_revoked",
                      "error_description": "customer is revoked"
                    }
                  },
                  "customer_user_revoked": {
                    "value": {
                      "error": "customer_user_revoked",
                      "error_description": "customer user is revoked"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Workspace user not found or inactive for the tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "workspace_user_not_found",
                  "error_description": "workspace user not found or inactive for tenant"
                }
              }
            }
          },
          "409": {
            "description": "Canonical user lookup returned multiple exact matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "user_lookup_ambiguous",
                  "error_description": "user lookup returned multiple exact matches"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/OAuth2BadGateway"
          }
        }
      }
    },
    "/users/token/exchange": {
      "post": {
        "summary": "Exchange bootstrap token for user session",
        "description": "Exchanges the short-lived bootstrap JWT issued by `POST /users/token` for a\nHydra-managed session token pair (`access_token` + `refresh_token`).\n\nThe bootstrap token is **single-use**: a second call with the same token\nreturns `401 invalid_grant`. Claims from the bootstrap token (workspace_id,\ntenant_id, user_id, etc.) are forwarded into the Hydra session via the\nserver-side authorization code flow.\n\nThe resulting `refresh_token` can be renewed via `POST /users/token/refresh`.\n",
        "operationId": "exchangeBootstrapToken",
        "tags": ["session"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              },
              "example": {
                "token": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ik9UO..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session token pair issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokenData"
                },
                "example": {
                  "access_token": "ory_at_...",
                  "refresh_token": "ory_rt_...",
                  "token_type": "bearer",
                  "expires_in": 3600
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "invalid_request",
                  "error_description": "invalid JSON body: ..."
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or already-used bootstrap token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "examples": {
                  "invalid_token": {
                    "value": {
                      "error": "invalid_token",
                      "error_description": "invalid or expired token"
                    }
                  },
                  "already_used": {
                    "value": {
                      "error": "invalid_grant",
                      "error_description": "bootstrap token has already been used"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/OAuth2BadGateway"
          }
        },
        "security": []
      }
    },
    "/users/token/refresh": {
      "post": {
        "summary": "Renew user session (refresh token)",
        "description": "Exchanges a Hydra refresh token for a new session token pair\n(`access_token` + `refresh_token`).\n\nThe `fluid-user-session` client credentials are handled server-side.\nBrowsers and mobile clients must **not** hold or send the client secret —\nonly the `refresh_token` is required.\n",
        "operationId": "refreshUserSession",
        "tags": ["session"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              },
              "example": {
                "refresh_token": "ory_rt_..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session renewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokenData"
                },
                "example": {
                  "access_token": "ory_at_...",
                  "refresh_token": "ory_rt_...",
                  "token_type": "bearer",
                  "expires_in": 3600
                }
              }
            }
          },
          "400": {
            "description": "Missing/malformed request body, or expired/revoked refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "examples": {
                  "invalid_body": {
                    "value": {
                      "error": "invalid_request",
                      "error_description": "invalid JSON body: ..."
                    }
                  },
                  "invalid_grant": {
                    "value": {
                      "error": "invalid_grant",
                      "error_description": "refresh token is expired or revoked"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid client credentials (server-side misconfiguration)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2ErrorResponse"
                },
                "example": {
                  "error": "invalid_client",
                  "error_description": "invalid client credentials"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/OAuth2BadGateway"
          }
        },
        "security": []
      }
    },
